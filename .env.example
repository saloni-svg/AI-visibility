# Copy this file to .env and fill in your keys. Never commit .env.

# Supabase (Project Settings -> API). The service role key bypasses row-level
# security, so only use it in server-side scripts, never in the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Publishable key (sb_publishable_...), used for dashboard sign-in. Safe to
# share with browsers, but still keep it in .env.
SUPABASE_PUBLISHABLE_KEY=

# AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=
# Perplexity key: create one at https://console.perplexity.ai
PERPLEXITY_API_KEY=

# DataForSEO (app.dataforseo.com > API Access): Google AI Overview answers and
# AI search volume. Use the API login and API password, not your account password.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional: override the models used (defaults shown)
# OPENAI_MODEL=gpt-4.1-mini
# GEMINI_MODEL=gemini-3.8-flash
# Perplexity Agent API: a preset (fast, low, medium, high, xhigh), or set
# PERPLEXITY_MODEL to a provider/model ID (e.g. openai/gpt-5.6-sol) to use that
# model with web search instead of the preset.
# PERPLEXITY_PRESET=fast
# PERPLEXITY_MODEL=
# PARSER_MODEL=gpt-4.1-mini

# Optional: how many times to ask each provider each prompt, and how many
# API calls to run at the same time
# ATTEMPTS_PER_PROMPT=3
# CONCURRENCY=4

# Optional: website analyses started from the dashboard (Analyze button)
# WEB_ATTEMPTS_PER_PROMPT=1   # times each question is asked per AI tool
# WEB_BATCH_SIZE=6            # calls per progress step
# REUSE_RESULTS_DAYS=7        # reuse results newer than this instead of paying again

# Optional: content agent and site search (RAG)
# AGENT_MODEL=gpt-4.1
# EMBEDDING_MODEL=text-embedding-3-small

# Optional: site audit
# AUDIT_PAGE_LIMIT=100
# PAGESPEED_API_KEY=        # Google PageSpeed Insights (free key) for Core Web Vitals

# Optional: prompt research. Prompts fetched per AI platform (highest AI volume first, max 1000).
# DataForSEO charges about $0.10 per request plus $0.001 per prompt returned.
# PROMPT_RESEARCH_LIMIT=500

# Keyword.com (app.keyword.com > Settings > Account): master API token. When set, position
# tracking reads Google rankings from Keyword.com and syncs keywords with its projects.
KEYWORDCOM_API_TOKEN=
