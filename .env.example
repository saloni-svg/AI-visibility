# Copy this file to .env and fill in your keys. Never commit .env.

# Supabase (Project Settings -> API). The service role key bypasses row-level
# security, so only use it in server-side scripts, never in the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Publishable key (sb_publishable_...), used for dashboard sign-in. Safe to
# share with browsers, but still keep it in .env.
SUPABASE_PUBLISHABLE_KEY=

# AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=
# Perplexity key: create one at https://console.perplexity.ai
PERPLEXITY_API_KEY=

# DataForSEO (app.dataforseo.com > API Access): Google AI Overview answers and
# AI search volume. Use the API login and API password, not your account password.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional: override the models used (defaults shown)
# OPENAI_MODEL=gpt-4.1-mini
# GEMINI_MODEL=gemini-3.8-flash
# Perplexity Agent API: a preset (fast, low, medium, high, xhigh), or set
# PERPLEXITY_MODEL to a provider/model ID (e.g. openai/gpt-5.6-sol) to use that
# model with web search instead of the preset.
# PERPLEXITY_PRESET=fast
# PERPLEXITY_MODEL=
# PARSER_MODEL=gpt-4.1-mini

# Optional: how many times to ask each provider each prompt, and how many
# API calls to run at the same time
# ATTEMPTS_PER_PROMPT=3
# CONCURRENCY=4

# Optional: website analyses started from the dashboard (Analyze button)
# WEB_ATTEMPTS_PER_PROMPT=1   # times each question is asked per AI tool
# WEB_BATCH_SIZE=6            # calls per progress step
# REUSE_RESULTS_DAYS=7        # reuse results newer than this instead of paying again

# Optional: content agent and site search (RAG)
# AGENT_MODEL=gpt-4.1
# EMBEDDING_MODEL=text-embedding-3-small

# Optional: site audit
# AUDIT_PAGE_LIMIT=100
# PAGESPEED_API_KEY=        # Google PageSpeed Insights (free key) for Core Web Vitals

# Optional: prompt research. Prompts fetched per AI platform (highest AI volume first, max 1000).
# DataForSEO charges about $0.10 per request plus $0.001 per prompt returned.
# PROMPT_RESEARCH_LIMIT=500

# Keyword.com (app.keyword.com > Settings > Account): master API token. When set, position
# tracking reads Google rankings from Keyword.com and syncs keywords with its projects.
KEYWORDCOM_API_TOKEN=

# Google Business Profile API (Review management: post replies straight to Google).
# Google Cloud Console, in the project approved for the Business Profile API:
#  1. APIs & Services > Library: enable "My Business Account Management API",
#     "My Business Business Information API" and "Google My Business API".
#  2. OAuth consent screen: add the scope .../auth/business.manage (and your Google account as a
#     test user while the app is in Testing).
#  3. Credentials > Create OAuth client ID > Web application. Authorized redirect URI:
#     http://localhost:3000/google/callback (plus your live URL's /google/callback when hosted).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: set when the app's public URL differs from the one the browser uses.
# GOOGLE_REDIRECT_URI=http://localhost:3000/google/callback

# Google Keyword Planner (Google Ads API): search volume and average CPC everywhere in the app.
# Google Ads (manager account) > Tools > API Center: developer token (needs Basic access; Test
# access can't read real data). Enable "Google Ads API" in the same Google Cloud project as
# GOOGLE_CLIENT_ID, and add the scope .../auth/adwords to the OAuth consent screen.
# Then use "Connect Google Ads" on Position tracking or Keyword overview.
GOOGLE_ADS_DEVELOPER_TOKEN=
# The Google Ads account to run Keyword Planner in (123-456-7890), and its manager account if you
# reach it through one.
GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_API_VERSION=v26

# SEO agent: Search Console and GA4 data through Windsor.ai (onboard.windsor.ai -> account settings -> API key).
WINDSOR_API_KEY=
