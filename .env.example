# Copy this file to .env and fill in your keys. Never commit .env.

# Supabase (Project Settings -> API). The service role key bypasses row-level
# security, so only use it in server-side scripts, never in the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=            # https://console.perplexity.ai

# Optional: override the models used (defaults shown)
# OPENAI_MODEL=gpt-4.1-mini
# GEMINI_MODEL=gemini-2.5-flash
# Perplexity Agent API: a preset (fast, low, medium, high, xhigh), or set
# PERPLEXITY_MODEL to a provider/model ID (e.g. openai/gpt-5.6-sol) to use that
# model with web search instead of the preset.
# PERPLEXITY_PRESET=fast
# PERPLEXITY_MODEL=
# PARSER_MODEL=gpt-4.1-mini

# Optional: how many times to ask each provider each prompt, and how many
# API calls to run at the same time
# ATTEMPTS_PER_PROMPT=3
# CONCURRENCY=4
